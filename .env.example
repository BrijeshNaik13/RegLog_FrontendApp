# ---------------------------------------------------------------------------
# Copy this file to ".env" in the same folder and adjust the values.
#
#     cp .env.example .env        (Linux / macOS)
#     copy .env.example .env      (Windows)
#
# Vite only exposes variables that start with VITE_ to the browser code, and
# only variables that are listed in this file (or in .env.local) are read.
# ".env" is listed in .gitignore, so it is never pushed to GitHub.
# ---------------------------------------------------------------------------

# Base URL of the Spring Boot backend.
# Do NOT put a trailing slash here.
VITE_API_BASE_URL=http://localhost:8080
